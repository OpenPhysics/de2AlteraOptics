{
  "name": "de2-altera-optics",
  "version": "0.1.0",
  "private": true,
  "description": "Web interface for the DE2 FPGA coincidence counter (quantum optics: A, B, AB and optional C, AC, BC)",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "dev:sim": "DE2_SIMULATE=1 vite",
    "start": "npm run build && node server/bridge.ts",
    "start:sim": "npm run build && node server/bridge.ts --simulate",
    "bridge": "node server/bridge.ts",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint src server tests",
    "format": "biome format --write ."
  },
  "author": "OpenPhysics Contributors",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26.1.2",
    "@types/w3c-web-serial": "^1.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
